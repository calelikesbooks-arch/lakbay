# Copy this file to ".env.local" and fill in your own values.
# ".env.local" is ignored by Git, so your values stay on your computer.
#
# Every variable that starts with VITE_ is copied INTO the public website.
# Anyone can read it in their browser. Never put a secret here.

# --- Supabase ------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API Keys.
# Use the PUBLISHABLE key (starts with "sb_publishable_") or the legacy
# "anon" key. NEVER use the "secret" / "service_role" key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Map tiles -------------------------------------------------------------
# MapLibre style URLs. Leave empty to use the free OpenFreeMap styles
# ("liberty" for light mode, "dark" for dark mode). No key needed.
# Attribution is added automatically by MapLibre.
VITE_MAP_STYLE_URL=
VITE_MAP_STYLE_URL_DARK=

# --- Place search (geocoding) ---------------------------------------------
# Search uses the public Nominatim service through LAKBAY's own proxy
# (/api/geocode). Usage policy: https://operations.osmfoundation.org/policies/nominatim/
# Set to "false" to turn off OpenStreetMap search in the app (LAKBAY's own
# terminal/stop search keeps working).
VITE_GEOCODER_ENABLED=true
# Leave empty to use /api/geocode (recommended).
VITE_GEOCODER_ENDPOINT=
