# Settings for the LAKBAY data pipeline (scripts in pipeline/).
# Copy to ".env.pipeline" and fill in. ".env.pipeline" is ignored by Git.
#
# The pipeline signs in as a MODERATOR or ADMIN user, so every rule in the
# database still applies. Do NOT put the service_role / secret key here;
# the pipeline refuses to run with one.

# Same values as the app (Supabase -> Project Settings -> API Keys)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# A LAKBAY user that has the moderator or admin role (see docs/database.md)
LAKBAY_PIPELINE_EMAIL=
LAKBAY_PIPELINE_PASSWORD=

# Identifies LAKBAY to OpenStreetMap services (required by their usage policy).
# Use your GitHub repository URL or a contact email.
PIPELINE_CONTACT=

# Optional: another Overpass server. Default: https://overpass-api.de/api/interpreter
OVERPASS_URL=
